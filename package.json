{
  "name": "baoyan-simulator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "content:build": "node scripts/build-content.mjs",
    "dev": "node scripts/build-content.mjs && vite --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build-content.mjs && vue-tsc --noEmit && vite build"
  },
  "dependencies": {
    "@fontsource/rajdhani": "^5.3.0",
    "@ibm/plex-sans-sc": "^1.1.0",
    "element-plus": "2.11.4",
    "gsap": "^3.15.0",
    "pinia": "3.0.3",
    "pixi.js": "^8.22.0",
    "vue": "3.5.22"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@prettier/plugin-php": "0.25.0",
    "@types/node": "22.18.6",
    "@vitejs/plugin-vue": "6.0.1",
    "javascript-obfuscator": "^5.9.0",
    "prettier": "3.9.10",
    "typescript": "5.9.2",
    "unplugin-vue-components": "29.1.0",
    "vite": "7.1.7",
    "vue-tsc": "3.0.8"
  }
}
